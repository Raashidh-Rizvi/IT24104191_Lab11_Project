# ===================================================================
# CampusEats - Railway Backend Environment Variables Template
# ===================================================================
# Dashboard Path: Railway -> Project -> CampusEats API Service -> Variables
#
# DEPLOYMENT NOTE:
# Whenever environment variables are added or changed in Railway,
# Railway automatically initiates a new deployment to restart the container.
#
# CONFLICT RESOLUTION:
# If you previously added dummy, placeholder, or conflicting variables
# (such as ConnectionStrings__Default with localhost or stale Railway Postgres credentials),
# DELETE them from the Railway Variables tab so DATABASE_URL is canonical.
# ===================================================================

# 1. ASP.NET Core Runtime Environment
ASPNETCORE_ENVIRONMENT=Production

# 2. Canonical Neon PostgreSQL Connection String
# Example: postgresql://YOUR_NEON_USER:YOUR_NEON_PASSWORD@YOUR_NEON_HOST/neondb?sslmode=require&channel_binding=require
DATABASE_URL=postgresql://YOUR_NEON_USER:YOUR_NEON_PASSWORD@YOUR_NEON_HOST/neondb?sslmode=require&channel_binding=require

# 3. CORS Configuration (Explicit Allowed Origins)
Cors__AllowedOrigins=https://it-24104191-lab11-project-lilac.vercel.app,https://it-24104191-lab11-project-jfjbfrgjk-raashidh-rizvis-projects.vercel.app,https://campuseats-it24104191.vercel.app,http://localhost:5173

# 4. JWT Authentication Security
Jwt__Issuer=CampusEats
Jwt__Audience=CampusEatsUsers
Jwt__Key=REPLACE_WITH_A_NEW_SECURE_RANDOM_SECRET_AT_LEAST_32_CHARS
