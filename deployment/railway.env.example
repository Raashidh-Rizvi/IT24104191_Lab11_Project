# ===================================================================
# CampusEats - Railway Backend Environment Variables Template
# ===================================================================
# Dashboard Path: Railway -> Project -> CampusEats API Service -> Variables
#
# DEPLOYMENT NOTE:
# Whenever environment variables are added or changed in Railway,
# Railway automatically initiates a new deployment to restart the container.
#
# CONFLICT RESOLUTION:
# If you previously added dummy, placeholder, or conflicting variables
# (such as ConnectionStrings__Default with localhost or stale Railway Postgres credentials),
# DELETE them from the Railway Variables tab so DATABASE_URL is canonical.
# ===================================================================

# 1. ASP.NET Core Runtime Environment
ASPNETCORE_ENVIRONMENT=Production

# 2. Canonical Neon PostgreSQL Connection String
# Obtain this from Neon Console: Project -> Dashboard -> Connection Details -> Connection String
# Example format: postgresql://neondb_owner:YOUR_PASSWORD@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://YOUR_NEON_USER:YOUR_NEON_PASSWORD@YOUR_NEON_HOST/neondb?sslmode=require

# 3. CORS Configuration (Explicit Allowed Origins)
# Include your Vercel production domain, preview domains, and local dev origins.
# Comma-separated without trailing slashes.
Cors__AllowedOrigins=https://it-24104191-lab11-project-jfjbfrgjk-raashidh-rizvis-projects.vercel.app,https://campuseats-it24104191.vercel.app,http://localhost:5173

# 4. JWT Authentication Security
# Generate a cryptographically strong random string (minimum 32 characters / 256 bits).
# E.g., generate via PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }))
Jwt__Issuer=CampusEats
Jwt__Audience=CampusEatsUsers
Jwt__Key=REPLACE_WITH_A_NEW_SECURE_RANDOM_SECRET_AT_LEAST_32_CHARS
