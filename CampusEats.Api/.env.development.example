# ===================================================================
# CampusEats API - Local Development Environment (.env.development)
# ===================================================================
# Copy this file to .env or use 'dotnet user-secrets' for local secrets.

ASPNETCORE_ENVIRONMENT=Development

# 1. Database Connection String (Local PostgreSQL or Neon Development Branch)
# Option A: Canonical URI format (recommended for Neon development branches):
DATABASE_URL=postgresql://neondb_owner:YOUR_DEV_PASSWORD@YOUR_DEV_HOST.neon.tech/neondb?sslmode=require

# Option B: Standard ADO.NET Key-Value format (for local PostgreSQL instance):
# ConnectionStrings__Default=Host=localhost;Port=5432;Database=campuseats;Username=postgres;Password=postgres;

# 2. CORS Allowed Origins (Comma-separated frontend origins)
Cors__AllowedOrigins=http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173

# 3. JWT Authentication Configuration (Local Development)
Jwt__Issuer=CampusEats
Jwt__Audience=CampusEatsUsers
Jwt__Key=REPLACE_WITH_A_LOCAL_DEVELOPMENT_SECRET_KEY_32_CHARS_MINIMUM!
