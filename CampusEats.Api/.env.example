# ===================================================================
# CampusEats API - Environment Variables Template (.env.example)
# ===================================================================

# 1. Database Connection String (PostgreSQL)
ConnectionStrings__Default=Host=localhost;Database=campuseats;Username=postgres;Password=postgres

# 2. JWT Authentication Secret Key (Minimum 32 characters)
Jwt__Key=your_super_secret_jwt_key_at_least_32_characters_long
Jwt__Issuer=CampusEats
Jwt__Audience=CampusEatsUsers

# 3. CORS Allowed Origins (Frontend URLs)
Cors__AllowedOrigins=http://localhost:5173,http://localhost:4173

# 4. ASP.NET Core Environment
ASPNETCORE_ENVIRONMENT=Development
