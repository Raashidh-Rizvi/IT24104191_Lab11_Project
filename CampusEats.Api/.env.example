# ===================================================================
# CampusEats API - Environment Variables Template (.env.example)
# ===================================================================

# 1. Database Connection String (PostgreSQL)
# Option A: Canonical URI format (Recommended for Neon / Railway)
DATABASE_URL=postgresql://YOUR_NEON_USER:YOUR_NEON_PASSWORD@YOUR_NEON_HOST/neondb?sslmode=require

# Option B: Standard Key-Value format (for local PostgreSQL)
# ConnectionStrings__Default=Host=localhost;Port=5432;Database=campuseats;Username=postgres;Password=postgres;

# 2. JWT Authentication Secret Key (Minimum 32 characters)
Jwt__Key=your_super_secret_jwt_key_at_least_32_characters_long
Jwt__Issuer=CampusEats
Jwt__Audience=CampusEatsUsers

# 3. CORS Allowed Origins (Frontend URLs, comma-separated)
Cors__AllowedOrigins=http://localhost:5173,http://localhost:4173,https://your-site.vercel.app

# 4. ASP.NET Core Environment
ASPNETCORE_ENVIRONMENT=Development
