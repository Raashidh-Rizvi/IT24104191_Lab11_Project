# ===================================================================
# CampusEats API - Production Environment Variables (.env.production)
# ===================================================================
# Copy-ready template for Railway production deployment.
# Set these in Railway Dashboard -> Project -> Service -> Variables.

ASPNETCORE_ENVIRONMENT=Production

# Canonical Neon PostgreSQL connection string (pooled or direct)
DATABASE_URL=postgresql://YOUR_NEON_USER:YOUR_NEON_PASSWORD@YOUR_NEON_HOST/neondb?sslmode=require&channel_binding=require

# Explicit CORS allowed origins (comma-separated, no trailing slashes)
Cors__AllowedOrigins=https://it-24104191-lab11-project-lilac.vercel.app,https://it-24104191-lab11-project-jfjbfrgjk-raashidh-rizvis-projects.vercel.app,http://localhost:5173

# JWT Authentication (generate a secure random 256-bit / 32+ char secret)
Jwt__Issuer=CampusEats
Jwt__Audience=CampusEatsUsers
Jwt__Key=REPLACE_WITH_A_NEW_SECURE_RANDOM_SECRET_AT_LEAST_32_CHARS
